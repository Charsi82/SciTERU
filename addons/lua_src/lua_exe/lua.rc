			VALUE "FileVersion", "1.0\0"
			VALUE "InternalName", "lua.exe\0"
			VALUE "LegalCopyright", "Copyright © 1994–2026 Lua.org, PUC-Rio.\0"
			VALUE "OriginalFilename", "lua.exe\0"
			VALUE "ProductName", "Lua\0"
			VALUE "ProductVersion", "5.5.1\0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
			VALUE "Translation", 0x0419, 0x04B0
	END
END
